extends "res://tests/building_controls.gd"

func run_checks() -> void:
	root.show()
	game = load("res://main.tscn").instantiate()
	root.add_child(game)
	current_scene = game
	await settle()
	game.set_process(false)
	var display: CanvasLayer
	for child in game.get_children():
		if child.has_method("toggle_pause_menu"): display = child
	display.resolution = Vector2i(1280, 720)
	display.window_mode = 0
	display.apply_display(false)
	await settle()
	game.cycle.skip_tutorial()
	game.grid.expand()
	mover = game.get_node("WorldInteractions")
	compactors = game.get_node("Compactors")
	compactors.set_process(false)
	var inspector: Node = game.get_node("ToolInspector")
	var coal := Vector2i(14, 1)
	var copper := Vector2i(16, 1)
	game.mining.place_vein(coal, 1)
	game.mining.place_vein(copper, 2, "copper")
	compactors.place(Vector2i(15, 3), 0)
	inspector.open_tool("compactor", Vector2i(15, 3))
	await settle()
	var frame: Control = inspector.contents.get_parent().get_parent().get_parent()
	var rect: Rect2 = frame.get_global_rect()
	check(is_equal_approx(rect.position.x, 20) and is_equal_approx(rect.end.y, 700) and rect.size.x <= 240 and rect.size.y < 210, "The compact inventory is anchored twenty pixels from the lower-left corner")
	for i in range(4):
		await mouse_move(point(coal))
		await mouse_button(point(coal), true)
		await mouse_button(point(coal), false)
	check(game.mining.nuggets_at(Vector2i(15, 1)) == 0 and game.mining.coal_veins[coal]["progress"] == 4, "Four real clicks leave the five-hardness coal vein one hit short")
	await mouse_move(point(coal))
	await mouse_button(point(coal), true)
	await mouse_button(point(coal), false)
	check(game.mining.nugget_type(Vector2i(15, 1)) == "coal" and game.mining.coal_veins[coal]["progress"] == 0 and inspector.is_open(), "The fifth click extracts coal while the corner inventory stays open")
	for i in range(6):
		await mouse_move(point(copper))
		await mouse_button(point(copper), true)
		await mouse_button(point(copper), false)
	check(game.mining.nuggets_at(Vector2i(16, 2)) == 0 and game.mining.copper_veins[copper]["progress"] == 6, "Six real clicks do not extract seven-hardness copper")
	await mouse_move(point(copper))
	await mouse_button(point(copper), true)
	await mouse_button(point(copper), false)
	check(game.mining.nugget_type(Vector2i(16, 2)) == "copper" and game.mining.copper_veins[copper]["progress"] == 0, "The seventh click extracts copper and resets its progress")
	if DisplayServer.get_name() != "headless" and "--capture" in OS.get_cmdline_user_args():
		await settle()
		root.get_texture().get_image().save_png("/workspace/.onboarding/display-test/corner-inventory.png")
	await key(KEY_ESCAPE)
	check(not inspector.is_open() and not display.menu_open, "ESC still closes the inventory before opening pause")
	game.mining.coal_nuggets.clear()
	game.mining.copper_nuggets.clear()
	game.drills.place(Vector2i(13, 1), 1)
	game.drills.place(Vector2i(16, 0), 2)
	for i in range(4): game.drills.tick()
	check(game.mining.nuggets_at(Vector2i(15, 1)) == 0 and game.mining.nuggets_at(Vector2i(16, 2)) == 0, "Four automatic mining actions do not complete either vein")
	game.drills.tick()
	check(game.mining.nugget_type(Vector2i(15, 1)) == "coal" and game.mining.nuggets_at(Vector2i(16, 2)) == 0, "Drills complete coal at five actions while copper remains unfinished")
	for i in range(2): game.drills.tick()
	check(game.mining.nugget_type(Vector2i(16, 2)) == "copper", "Drills complete copper at seven actions")
	print("RESULT: ", passed, " passed; ", failed, " failed; hardness and corner inventory")
	game.queue_free()
	await settle()
	quit(0 if failed == 0 else 1)
