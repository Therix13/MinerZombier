extends "res://tests/building_controls.gd"

func run_checks() -> void:
	root.show()
	game = load("res://main.tscn").instantiate()
	root.add_child(game)
	current_scene = game
	await settle()
	game.set_process(false)
	var display: CanvasLayer
	for child in game.get_children():
		if child.has_method("toggle_pause_menu"): display = child
	display.resolution = Vector2i(1280, 720)
	display.window_mode = 0
	display.apply_display(false)
	await settle()
	game.cycle.skip_tutorial()
	game.grid.expand()
	game.grid.purchase_defense_platforms()
	mover = game.get_node("WorldInteractions")
	compactors = game.get_node("Compactors")
	compactors.set_process(false)
	shop = game.shop
	var furnace: Node = game.get_node("Furnaces")
	furnace.set_process(false)
	var inspector: Node = game.get_node("ToolInspector")
	var c := Vector2i(15, 1)
	var a := c + Vector2i.LEFT
	var b := c + Vector2i.RIGHT
	var out := c + Vector2i.UP
	furnace.place(c)
	for kind: String in ["copper", "copper_2", "copper_3", "copper_ingot", "copper_ingot_4"]:
		put(a, {kind: 1})
		check(not mover.drop("nugget", a, c) and game.mining.nugget_type(a) == kind, "The furnace preserves rejected %s" % kind)
		game.mining.items_for(kind).clear()
	put(a, {"copper_4": 1})
	check(mover.drop("nugget", a, c) and furnace.stored_items(c).get("copper_4") == 1, "One level-four copper nugget enters the material slot")
	furnace.process_smelting(10)
	check(furnace.machines[c]["input"] == "copper_4" and furnace.machines[c]["output"] == "" and furnace.machines[c]["elapsed"] == 0, "No fuel means no processing or free ingot")
	put(a, {"copper_4": 1})
	check(not mover.drop("nugget", a, c) and game.mining.nuggets_at(a) == 1, "The occupied material slot rejects a second nugget without loss")
	game.mining.copper_level4_nuggets.clear()
	put(a, {"coal_4": 1})
	check(mover.drop("nugget", a, c) and furnace.machines[c]["fuel"] == 20 and not furnace.stored_items(c).has("coal_4"), "Level-four coal is consumed into twenty fuel, separately from the copper")
	var cash: int = game.economy.coins
	furnace.process_smelting(3.9)
	check(furnace.machines[c]["fuel"] == 0 and furnace.machines[c]["output"] == "" and furnace.machines[c]["input"] == "copper_4", "Twenty fuel starts one four-second batch; nothing finishes early")
	put(out, {"coal": 1})
	furnace.process_smelting(0.1)
	check(furnace.machines[c]["input"] == "" and furnace.machines[c]["output"] == "copper_ingot" and furnace.machines[c]["fuel"] == 0, "One level-four nugget becomes exactly one level-one ingot")
	furnace.process_smelting(100)
	check(furnace.stored_items(c) == {"copper_ingot": 1} and furnace.machines[c]["fuel"] == 0 and game.economy.coins == cash, "A blocked product neither duplicates nor burns extra fuel or grants rewards")
	await mouse_move(point(c))
	await mouse_button(point(c), true)
	await mouse_button(point(c), false)
	check(inspector.is_open() and inspector.withdraw_buttons.has("copper_ingot") and inspector.heat_label.text == "0 / 40", "A real click shows the finished ingot next to remaining fuel")
	if DisplayServer.get_name() != "headless" and "--capture" in OS.get_cmdline_user_args():
		await settle()
		root.get_texture().get_image().save_png("/workspace/.onboarding/display-test/smelting-inventory.png")
	await click_control(inspector.withdraw_buttons["copper_ingot"])
	check(furnace.stored_items(c).is_empty() and game.mining.items_for("copper_ingot").size() == 1 and not inspector.withdraw("copper_ingot"), "Withdrawing the output returns a single ingot, never a duplicate")
	await key(KEY_ESCAPE)
	clear_items()
	furnace.place(c)
	furnace.receive(c, "copper_4")
	furnace.receive(c, "coal_4")
	furnace.process_smelting(2)
	inspector.open_tool("furnace", c)
	check(inspector.withdraw("copper_4") and furnace.machines[c]["input"] == "" and furnace.machines[c]["elapsed"] == 0 and furnace.machines[c]["fuel"] == 0, "Removing unfinished ore stops the batch without refunding consumed fuel")
	inspector.close_inspector()
	clear_items()
	furnace.place(c)
	for belt: Vector2i in [a, b, c + Vector2i.DOWN]:
		game.conveyors.place(belt, 1 if belt == a else (3 if belt == b else 0))
	put(a, {"coal_4": 1})
	put(b, {"copper_4": 1})
	put(c + Vector2i.DOWN, {"copper_4": 1})
	game.conveyors.tick()
	check(furnace.machines[c]["fuel"] == 20 and furnace.machines[c]["input"] == "copper_4" and game.mining.nugget_type(c + Vector2i.DOWN) == "copper_4", "Simultaneous belts reserve fuel and one material slot without losing the rejected ore")
	game.conveyors.place(out, 0)
	furnace.process_smelting(4)
	check(game.mining.nugget_type(out) == "copper_ingot" and furnace.machines[c]["output"] == "", "An outward conveyor receives the finished ingot")
	furnace.process_smelting(100)
	check(game.mining.nuggets_at(out) == 1, "An idle furnace cannot duplicate the conveyor product")
	clear_items()
	for level in range(1, 5):
		var kind: String = "copper_ingot" if level == 1 else "copper_ingot_" + str(level)
		put(a, {kind: 1})
		put(b, {kind: 1})
		if level < 4:
			check(mover.drop("nugget", a, b) and game.mining.nugget_type(b) == "copper_ingot_" + str(level + 1) and game.mining.nuggets_at(a) == 0, "Two level-%d ingots manually fuse into their next ingot tier" % level)
		else: check(not game.mining.fuse(a, b), "Level-four ingots are the final tier")
		clear_items()
		compactors.place(c, 1)
		if level < 4:
			check(compactors.receive(c, kind) and compactors.receive(c, kind), "Compactors accept two matching level-%d ingots" % level)
			compactors.process_outputs(4)
			check(game.mining.nugget_type(b) == "copper_ingot_" + str(level + 1), "Compactors preserve the ingot family in their fused product")
		else: check(not compactors.receive(c, kind), "Compactors never make level-five ingots")
		clear_items()
		var platform: Vector2i = game.grid.defense_cell("left")
		game.launchers.place(platform)
		put(a, {kind: 1})
		check(not mover.drop("nugget", a, platform) and game.mining.nugget_type(a) == kind, "Level-one weapons reject level-%d ingots without consuming them" % level)
		cash = game.economy.coins
		check(mover.drop("nugget", a, game.grid.sale_cell) and game.economy.coins == cash + [150,400,1000,2500][level-1], "Level-%d ingots sell with the correct value" % level)
		clear_items()
	put(a, {"copper_2": 1})
	put(b, {"copper_ingot": 1})
	check(not game.mining.fuse(a, b), "Ore and ingots cannot fuse together")
	clear_items()
	furnace.place(c)
	furnace.receive(c, "coal_4")
	furnace.receive(c, "copper_4")
	furnace.process_smelting(2)
	var saved: Dictionary = furnace.machines[c].duplicate(true)
	check(mover.drop("furnace", c, b) and furnace.machines[b] == saved, "Moving a working furnace preserves its fuel and progress")
	check(mover.sell("furnace", b) and game.mining.nugget_type(b) == "copper_4" and game.mining.nuggets_at(b) == 1, "Selling a working furnace returns only its unconsumed material")
	clear_items()
	if DisplayServer.get_name() != "headless" and "--capture" in OS.get_cmdline_user_args():
		await create_timer(3.1).timeout
	for direction in range(4):
		furnace.place(c, direction)
		var target: Vector2i = c + furnace.DIRECTIONS[direction]
		furnace.receive(c, "coal_4")
		furnace.receive(c, "copper_4")
		furnace.process_smelting(2)
		check(furnace.machines[c]["elapsed"] == 2.0 and furnace.machines[c]["burning"], "Direction %d shows half a batch after two seconds" % direction)
		if direction == 1 and DisplayServer.get_name() != "headless" and "--capture" in OS.get_cmdline_user_args():
			furnace.queue_redraw()
			await settle()
			root.get_texture().get_image().save_png("/workspace/.onboarding/display-test/furnace-progress.png")
		put(target, {"coal": 1})
		furnace.process_smelting(2)
		check(furnace.machines[c]["output"] == "copper_ingot" and furnace.machines[c]["elapsed"] == 4, "Direction %d retains the completed product behind a blocked exit" % direction)
		game.mining.items_for("coal").erase(target)
		furnace.process_smelting(0)
		check(game.mining.nugget_type(target) == "copper_ingot" and furnace.machines[c]["elapsed"] == 0, "Direction %d ejects onto empty ground and resets progress" % direction)
		clear_items()
	furnace.place(c, 1)
	game.conveyors.place(b, 3)
	furnace.receive(c, "coal_4")
	furnace.receive(c, "copper_4")
	furnace.process_smelting(4)
	check(furnace.machines[c]["output"] == "copper_ingot" and game.mining.nuggets_at(b) == 0, "A belt facing into the outlet cannot accept the finished ingot")
	game.conveyors.belts[b]["direction"] = 1
	furnace.process_smelting(0)
	check(game.mining.nugget_type(b) == "copper_ingot", "Correcting the outlet belt releases the waiting product")
	clear_items()
	game.economy.toggle_developer_mode()
	mover.select_item("furnace")
	await settle()
	var before: int = game.placement_direction
	await key(KEY_R)
	check(game.placement_direction == (before + 1) % 4, "R rotates the furnace placement outlet")
	await place_at(c)
	check(game.get_node("Construction").plans[c]["direction"] == (before + 1) % 4, "Blueprint stores the preview outlet direction")
	game.get_node("Construction").receive(c, "coal_4")
	game.get_node("Construction").receive(c, "coal_4")
	check(furnace.machines[c]["direction"] == (before + 1) % 4, "Placement stores the preview outlet direction")
	await mouse_move(point(c))
	await mouse_button(point(c), true)
	await key(KEY_R)
	await mouse_move(point(b))
	await mouse_button(point(b), false)
	check(furnace.machines.has(b) and furnace.machines[b]["direction"] == (before + 2) % 4, "Dragging and R rotate the actual furnace outlet")
	if DisplayServer.get_name() != "headless" and "--capture" in OS.get_cmdline_user_args():
		clear_items()
		for level in range(1, 5): game.mining.items_for("copper_ingot" if level == 1 else "copper_ingot_" + str(level))[Vector2i(15, level - 1)] = 1
		game.redraw_world()
		await settle()
		root.get_texture().get_image().save_png("/workspace/.onboarding/display-test/ingot-levels.png")
	print("RESULT: ", passed, " passed; ", failed, " failed; smelting and ingots")
	game.queue_free()
	await settle()
	quit(0 if failed == 0 else 1)

func clear_items() -> void:
	super.clear_items()
	game.shop.accept_unlock_notice()
