extends "res://tests/building_controls.gd"

func run_checks() -> void:
	root.show()
	game = load("res://main.tscn").instantiate()
	root.add_child(game)
	current_scene = game
	await settle()
	game.set_process(false)
	var display: CanvasLayer
	for child in game.get_children():
		if child.has_method("toggle_pause_menu"): display = child
	display.resolution = Vector2i(1280, 720)
	display.window_mode = 0
	display.apply_display(false)
	await settle()
	game.cycle.skip_tutorial()
	game.grid.expand()
	game.grid.purchase_defense_platforms()
	mover = game.get_node("WorldInteractions")
	compactors = game.get_node("Compactors")
	compactors.set_process(false)
	shop = game.shop
	var furnace: Node = game.get_node("Furnaces")
	furnace.set_process(false)
	var inspector: Node = game.get_node("ToolInspector")
	var c := Vector2i(15, 1)
	var a := c + Vector2i.LEFT
	var b := c + Vector2i.RIGHT
	var out := c + Vector2i.UP
	furnace.place(c)
	for kind: String in ["coal", "coal_2", "coal_3", "brass", "brass_2", "brass_3", "brass_ingot", "brass_ingot_4"]:
		put(a, {kind: 1})
		check(not mover.drop("nugget", a, c) and game.mining.nugget_type(a) == kind, "The furnace preserves rejected %s" % kind)
		game.mining.items_for(kind).clear()
	put(a, {"brass_4": 1})
	check(mover.drop("nugget", a, c) and furnace.stored_items(c).get("brass_4") == 1, "One level-four brass nugget enters the material slot")
	furnace.process_smelting(10)
	check(furnace.machines[c]["input"] == "brass_4" and furnace.machines[c]["output"] == "" and furnace.machines[c]["elapsed"] == 0, "No fuel means no processing or free ingot")
	put(a, {"brass_4": 1})
	check(not mover.drop("nugget", a, c) and game.mining.nuggets_at(a) == 1, "The occupied material slot rejects a second nugget without loss")
	game.mining.brass_level4_nuggets.clear()
	put(a, {"coal_4": 1})
	check(mover.drop("nugget", a, c) and furnace.machines[c]["fuel"] == 20 and not furnace.stored_items(c).has("coal_4"), "Level-four coal is consumed into twenty fuel, separately from the brass")
	var xp: int = game.progression.total_experience
	var cash: int = game.economy.coins
	furnace.process_smelting(3.9)
	check(furnace.machines[c]["fuel"] == 19 and furnace.machines[c]["output"] == "" and furnace.machines[c]["input"] == "brass_4", "One fuel starts a four-second batch; nothing finishes early")
	furnace.process_smelting(0.1)
	check(furnace.machines[c]["input"] == "" and furnace.machines[c]["output"] == "brass_ingot" and furnace.machines[c]["fuel"] == 19, "One level-four nugget becomes exactly one level-one ingot")
	furnace.process_smelting(100)
	check(furnace.stored_items(c) == {"brass_ingot": 1} and furnace.machines[c]["fuel"] == 19 and game.progression.total_experience == xp and game.economy.coins == cash, "A blocked product neither duplicates nor burns extra fuel or grants rewards")
	await mouse_move(point(c))
	await mouse_button(point(c), true)
	await mouse_button(point(c), false)
	check(inspector.is_open() and inspector.withdraw_buttons.has("brass_ingot") and inspector.heat_label.text == "19 / 40", "A real click shows the finished ingot next to remaining fuel")
	if DisplayServer.get_name() != "headless" and "--capture" in OS.get_cmdline_user_args():
		await settle()
		root.get_texture().get_image().save_png("/workspace/.onboarding/display-test/smelting-inventory.png")
	await click_control(inspector.withdraw_buttons["brass_ingot"])
	check(furnace.stored_items(c).is_empty() and game.mining.items_for("brass_ingot").size() == 1 and not inspector.withdraw("brass_ingot"), "Withdrawing the output returns a single ingot, never a duplicate")
	await key(KEY_ESCAPE)
	clear_items()
	furnace.place(c)
	furnace.receive(c, "brass_4")
	furnace.receive(c, "coal_4")
	furnace.process_smelting(2)
	inspector.open_tool("furnace", c)
	check(inspector.withdraw("brass_4") and furnace.machines[c]["input"] == "" and furnace.machines[c]["elapsed"] == 0 and furnace.machines[c]["fuel"] == 19, "Removing unfinished ore stops the batch without refunding consumed fuel")
	inspector.close_inspector()
	clear_items()
	furnace.place(c)
	for belt: Vector2i in [a, b, c + Vector2i.DOWN]:
		game.conveyors.place(belt, 1 if belt == a else (3 if belt == b else 0))
	put(a, {"coal_4": 1})
	put(b, {"brass_4": 1})
	put(c + Vector2i.DOWN, {"brass_4": 1})
	game.conveyors.tick()
	check(furnace.machines[c]["fuel"] == 20 and furnace.machines[c]["input"] == "brass_4" and game.mining.nugget_type(c + Vector2i.DOWN) == "brass_4", "Simultaneous belts reserve fuel and one material slot without losing the rejected ore")
	game.conveyors.place(out, 0)
	furnace.process_smelting(4)
	check(game.mining.nugget_type(out) == "brass_ingot" and furnace.machines[c]["output"] == "", "An outward conveyor receives the finished ingot")
	furnace.process_smelting(100)
	check(game.mining.nuggets_at(out) == 1, "An idle furnace cannot duplicate the conveyor product")
	clear_items()
	for level in range(1, 5):
		var kind: String = "brass_ingot" if level == 1 else "brass_ingot_" + str(level)
		put(a, {kind: 1})
		put(b, {kind: 1})
		if level < 4:
			check(mover.drop("nugget", a, b) and game.mining.nugget_type(b) == "brass_ingot_" + str(level + 1) and game.mining.nuggets_at(a) == 0, "Two level-%d ingots manually fuse into their next ingot tier" % level)
		else: check(not game.mining.fuse(a, b), "Level-four ingots are the final tier")
		clear_items()
		compactors.place(c, 1)
		if level < 4:
			check(compactors.receive(c, kind) and compactors.receive(c, kind), "Compactors accept two matching level-%d ingots" % level)
			compactors.process_outputs(4)
			check(game.mining.nugget_type(b) == "brass_ingot_" + str(level + 1), "Compactors preserve the ingot family in their fused product")
		else: check(not compactors.receive(c, kind), "Compactors never make level-five ingots")
		clear_items()
		var platform: Vector2i = game.grid.defense_cell("left")
		game.launchers.place(platform)
		put(a, {kind: 1})
		check(not mover.drop("nugget", a, platform) and game.mining.nugget_type(a) == kind, "Level-one weapons reject level-%d ingots without consuming them" % level)
		cash = game.economy.coins
		xp = game.progression.total_experience
		check(mover.drop("nugget", a, game.grid.sale_cell) and game.economy.coins == cash + 189 * int(pow(3, level - 1)) and game.progression.total_experience == xp + 16 * int(pow(2, level - 1)), "Level-%d ingots sell with the correct value and input-equivalent EXP" % level)
		clear_items()
	put(a, {"brass_2": 1})
	put(b, {"brass_ingot": 1})
	check(not game.mining.fuse(a, b), "Ore and ingots cannot fuse together")
	clear_items()
	furnace.place(c)
	furnace.receive(c, "coal_4")
	furnace.receive(c, "brass_4")
	furnace.process_smelting(2)
	var saved: Dictionary = furnace.machines[c].duplicate(true)
	check(mover.drop("furnace", c, b) and furnace.machines[b] == saved, "Moving a working furnace preserves its fuel and progress")
	check(mover.sell("furnace", b) and game.mining.nugget_type(b) == "brass_4" and game.mining.nuggets_at(b) == 1, "Selling a working furnace returns only its unconsumed material")
	if DisplayServer.get_name() != "headless" and "--capture" in OS.get_cmdline_user_args():
		clear_items()
		for level in range(1, 5): game.mining.items_for("brass_ingot" if level == 1 else "brass_ingot_" + str(level))[Vector2i(15, level - 1)] = 1
		game.redraw_world()
		await settle()
		root.get_texture().get_image().save_png("/workspace/.onboarding/display-test/ingot-levels.png")
	print("RESULT: ", passed, " passed; ", failed, " failed; smelting and ingots")
	game.queue_free()
	await settle()
	quit(0 if failed == 0 else 1)
