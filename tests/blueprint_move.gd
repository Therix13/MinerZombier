extends "res://tests/interactions.gd"

func run_checks() -> void:
	root.show()
	game = load("res://main.tscn").instantiate()
	root.add_child(game)
	current_scene = game
	await settle()
	game.display_settings.resolution = Vector2i(1280,720)
	game.display_settings.window_mode = 0
	game.display_settings.apply_display(false)
	game.cycle.skip_tutorial()
	game.grid.expand()
	game.grid.purchase_defense_platforms()
	mover = game.get_node("WorldInteractions")
	var construction: Node = game.get_node("Construction")
	var a := Vector2i(15,1)
	var b := Vector2i(16,2)
	var blocked := Vector2i(14,2)
	var money: int = game.economy.coins
	for item: String in construction.RECIPES:
		clear_items()
		construction.place(a,item,2,350)
		var initial: Dictionary = construction.plans[a].duplicate(true)
		check(mover.can_drop("blueprint",a,b) and mover.drop("blueprint",a,b),"Blueprint moves to an empty valid tile: " + item)
		check(not construction.plans.has(a) and construction.plans[b] == initial and game.economy.coins == money,"Moving preserves recipe, direction and paid value without charging again: " + item)
		check(not mover.drop("blueprint",b,Vector2i(0,0)) and not mover.drop("blueprint",b,game.grid.sale_cell),"Invalid terrain and the chest cannot consume a blueprint: " + item)
		game.mining.place_vein(blocked,1)
		check(not mover.drop("blueprint",b,blocked) and construction.plans[b] == initial,"Occupied destinations leave the plan unchanged: " + item)
	clear_items()
	construction.place(a,"furnace",2,350)
	construction.receive(a,"coal_4")
	var partial: Dictionary = construction.plans[a].duplicate(true)
	var inspector: Node = game.get_node("ToolInspector")
	inspector.open_tool("blueprint",a)
	await drag(a,b)
	check(not construction.plans.has(a) and construction.plans.get(b,{}) == partial,"Dragging with real mouse events moves a partially supplied furnace")
	check(inspector.cell == b and inspector.is_open(),"The open content panel follows the relocated plan")
	check(game.economy.coins == money and construction.can_receive(b,"coal_4"),"Delivered coal remains stored and only the missing coal is requested")
	var saves: Node = game.get_node("SaveGame")
	var state: Dictionary = saves.snapshot()
	check(saves.restore_snapshot(state) and construction.plans[b] == partial,"Saving and restoring preserves the new position and delivered ingredients")
	game.cycle.is_night = true
	check(not mover.drop("blueprint",b,a) and not construction.move_plan(b,a),"Blueprints retain the normal restriction against building changes during a wave")
	game.cycle.is_night = false
	check(construction.receive(b,"coal_4") and game.get_node("Furnaces").machines.has(b) and not game.get_node("Furnaces").machines.has(a),"The remaining material constructs the furnace at its new tile")
	clear_items()
	construction.place(a,"launcher",1,200)
	construction.receive(a,"brass_ingot_3")
	var platform: Vector2i = game.grid.defense_cell("left")
	check(mover.drop("blueprint",a,platform) and construction.plans[platform]["delivered"] == {"brass_ingot_3":1},"A launcher blueprint can move onto its defense platform with its ingot")
	check(construction.receive(platform,"brass_ingot") and game.launchers.launchers.has(platform),"The relocated launcher activates after its last ingredient arrives")
	clear_items()
	construction.place(a,"furnace",0,350)
	check(not mover.drop("blueprint",a,platform),"A furnace blueprint cannot be moved onto a weapon-only platform")
	construction.receive(a,"coal_4")
	mover.drop("blueprint",a,b)
	check(construction.cancel(b) and game.economy.coins == money+350 and game.mining.nugget_type(b) == "coal_4","Canceling a moved blueprint refunds its original payment and material exactly once")
	check(not construction.cancel(b) and game.economy.coins == money+350,"Repeated cancellation cannot duplicate a moved plan's refund")
	game.queue_free()
	await process_frame
	print("RESULT: %d passed, %d failed; movable blueprints" % [passed,failed])
	quit(1 if failed else 0)
