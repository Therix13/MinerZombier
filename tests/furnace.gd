extends "res://tests/building_controls.gd"

func run_checks() -> void:
	root.show()
	game = load("res://main.tscn").instantiate()
	root.add_child(game)
	current_scene = game
	await settle()
	game.set_process(false)
	var display: CanvasLayer
	for child in game.get_children():
		if child.has_method("toggle_pause_menu"): display = child
	display.resolution = Vector2i(1280, 720)
	display.window_mode = 0
	display.apply_display(false)
	await settle()
	game.cycle.skip_tutorial()
	game.grid.expand()
	shop = game.shop
	mover = game.get_node("WorldInteractions")
	compactors = game.get_node("Compactors")
	compactors.set_process(false)
	var furnace: Node = game.get_node("Furnaces")
	furnace.set_process(false)
	var inspector: Node = game.get_node("ToolInspector")
	var c := Vector2i(15, 1)
	var a := c + Vector2i.LEFT
	var b := c + Vector2i.RIGHT
	check(not mover.select_item("furnace"), "The furnace follows normal research locks")
	game.economy.toggle_developer_mode()
	shop.open_shop()
	await wait_shop()
	shop.open_category("HERRAMIENTAS")
	await settle()
	check(shop.item_buttons.has("furnace"), "DEV exposes the furnace under tools")
	await click_control(shop.item_buttons["furnace"]["button"])
	await wait_shop()
	check(mover.placing_furnace and game.economy.coins == 500, "Selecting a furnace does not charge the preview")
	await place_at(c)
	check(furnace.machines.has(c) and not mover.placing_furnace, "A real click places the furnace")
	check(not game.mining.can_place_vein(c) and not game.drills.can_place(c) and not game.conveyors.can_place(c) and not compactors.can_place(c) and not game.mining.can_move_nugget(c), "All construction and loose-ore placement respects the furnace footprint")
	for kind: String in ["coal_4"]:
		furnace.machines[c] = {"fuel": 0, "direction": 0}
		put(a, {kind: 1})
		check(mover.drop("nugget", a, c) and furnace.machines[c]["fuel"] == furnace.FUEL_VALUES[kind] and game.mining.nuggets_at(a) == 0, "Manual %s adds exactly %d fuel" % [kind, furnace.FUEL_VALUES[kind]])
	furnace.machines[c] = {"fuel": 0, "direction": 0}
	for kind: String in ["copper", "copper_2", "copper_3"]:
		put(a, {kind: 1})
		check(not mover.drop("nugget", a, c) and game.mining.nugget_type(a) == kind, "Nonfuel %s is preserved outside the furnace" % kind)
		game.mining.items_for(kind).clear()
	for i in range(2): furnace.receive(c, "coal_4")
	put(a, {"coal": 1})
	check(furnace.machines[c]["fuel"] == 40 and not mover.drop("nugget", a, c) and game.mining.nuggets_at(a) == 1, "A full furnace rejects extra coal without consuming it")
	game.mining.coal_nuggets.clear()
	game.conveyors.place(a, 1)
	game.conveyors.place(b, 3)
	furnace.machines[c] = {"fuel": 20, "direction": 0}
	put(a, {"coal_4": 1})
	put(b, {"coal_4": 1})
	game.conveyors.tick()
	check(furnace.machines[c]["fuel"] == 40 and game.mining.nuggets_at(a) == 0 and game.mining.nugget_type(b) == "coal_4", "Competing belts respect remaining fuel capacity and preserve rejected coal")
	game.mining.coal_level4_nuggets.clear()
	furnace.machines[c] = {"fuel": 0, "direction": 0}
	for i in range(2): furnace.receive(c, "coal_4")
	var saved: Dictionary = furnace.machines[c].duplicate(true)
	check(mover.drop("furnace", c, Vector2i(15, 2)) and furnace.machines[Vector2i(15, 2)] == saved, "Moving a fueled furnace preserves its full inventory")
	check(mover.drop("furnace", Vector2i(15, 2), c), "The fueled furnace can be returned")
	await mouse_move(point(c))
	await mouse_button(point(c), true)
	await mouse_button(point(c), false)
	check(inspector.is_open() and inspector.inventory().is_empty() and inspector.heat_label.text == "40 / 40" and mover.phase_allows(), "A click opens the corner inventory while world actions remain available")
	if "--capture" in OS.get_cmdline_user_args() and DisplayServer.get_name() != "headless":
		await settle()
		root.get_texture().get_image().save_png("/workspace/.onboarding/display-test/furnace-inventory.png")
	check(not inspector.withdraw_buttons.has("coal_4") and not inspector.withdraw("coal_4") and furnace.machines[c]["fuel"] == 40 and game.mining.coal_level4_nuggets.is_empty(), "Converted fuel is neither stored coal nor withdrawable material")
	await key(KEY_ESCAPE)
	check(not inspector.is_open() and not display.menu_open, "ESC closes the inventory without opening pause")
	game.economy.toggle_developer_mode()
	game.progression.add_experience(130)
	game.research_technology("drill")
	game.research_technology("furnace")
	check(game.progression.is_item_unlocked("furnace"), "Normal research can unlock the furnace")
	var cash: int = game.economy.coins
	check(mover.sell("furnace", c) and game.economy.coins == cash + 175 and not furnace.machines.has(c) and game.mining.nuggets_at(c) == 0, "Reselling a furnace never refunds consumed coal")
	clear_items()
	compactors.place(c, 1)
	compactors.receive(c, "copper_2")
	compactors.receive(c, "copper_2")
	compactors.process_outputs(2)
	await mouse_move(point(c))
	await mouse_button(point(c), true)
	await mouse_button(point(c), false)
	check(inspector.is_open() and inspector.kind == "compactor", "Clicking a compactor opens its live material inventory")
	check(inspector.withdraw("copper_2") and compactors.machines[c]["count"] == 1 and compactors.machines[c]["elapsed"] == 0 and game.mining.copper_level2_nuggets.size() == 1, "Withdrawing from a processing compactor preserves the material and resets its timer")
	inspector.close_inspector()
	clear_items()
	game.drills.place(c, 0)
	await mouse_move(point(c))
	await mouse_button(point(c), true)
	await mouse_button(point(c), false)
	check(inspector.is_open() and inspector.inventory().is_empty(), "Drills can be inspected without inventing internal materials")
	inspector.close_inspector()
	clear_items()
	game.grid.purchase_defense_platforms()
	var platform: Vector2i = game.grid.defense_cell("left")
	game.launchers.place(platform)
	game.launchers.receive(platform, "copper")
	inspector.open_tool("launcher", platform)
	check(inspector.withdraw("copper") and game.launchers.launchers[platform]["ammo"].is_empty() and game.mining.copper_nuggets.size() == 1 and not inspector.withdraw("copper"), "The weapon inventory returns ammo once without duplication")
	inspector.close_inspector()
	clear_items()
	compactors.place(c, 1)
	compactors.receive(c, "coal_3")
	for at: Vector2i in game.grid.owned_tiles:
		if game.mining.can_move_nugget(at): game.mining.items_for("coal")[at] = 1
	inspector.open_tool("compactor", c)
	check(not inspector.withdraw("coal_3") and compactors.machines[c]["count"] == 1 and inspector.inventory().get("coal_3") == 1, "A full grid cannot lose or duplicate withdrawn materials")
	inspector.close_inspector()
	clear_items()
	var balance: int = game.economy.coins
	mover.select_item("furnace")
	await place_at(c)
	check(game.economy.coins == balance - 350 and furnace.machines.has(c), "A normal furnace charges 350 only on valid placement")
	print("RESULT: ", passed, " passed; ", failed, " failed; furnace and inventories")
	game.queue_free()
	await settle()
	quit(0 if failed == 0 else 1)
