extends RefCounted

# Generated from the game's vector artwork by tests/build_art_atlas.gd.
# Shared 2x sprites avoid rebuilding hundreds of tiny shapes every frame.
const KEYS := ["coal:0:0","coal:0:1","coal:0:2","coal:0:3","coal:0:4","brass:0:0","brass:0:1","brass:0:2","brass:0:3","brass:0:4","brass:0:5","brass:0:6","belt:straight:0","belt:corner_right:0","belt:corner_left:0","belt:junction:0","drill:0","compactor:0","furnace:0:0","furnace:0:1","coal:1:0","coal:1:1","coal:1:2","coal:1:3","coal:1:4","brass:1:0","brass:1:1","brass:1:2","brass:1:3","brass:1:4","brass:1:5","brass:1:6","belt:straight:1","belt:corner_right:1","belt:corner_left:1","belt:junction:1","drill:1","compactor:1","furnace:1:0","furnace:1:1","coal:2:0","coal:2:1","coal:2:2","coal:2:3","coal:2:4","brass:2:0","brass:2:1","brass:2:2","brass:2:3","brass:2:4","brass:2:5","brass:2:6","belt:straight:2","belt:corner_right:2","belt:corner_left:2","belt:junction:2","drill:2","compactor:2","furnace:2:0","furnace:2:1","coal:3:0","coal:3:1","coal:3:2","coal:3:3","coal:3:4","brass:3:0","brass:3:1","brass:3:2","brass:3:3","brass:3:4","brass:3:5","brass:3:6","belt:straight:3","belt:corner_right:3","belt:corner_left:3","belt:junction:3","drill:3","compactor:3","furnace:3:0","furnace:3:1","ore:coal","ore:brass","ore:coal_2","ore:brass_2","ore:coal_3","ore:brass_3","ore:coal_4","ore:brass_4","ore:brass_ingot","ore:brass_ingot_2","ore:brass_ingot_3","ore:brass_ingot_4","platform"]
const PNG := ""
static var texture: ImageTexture
static var regions: Dictionary = {}

static func prepare() -> bool:
	if texture == null:
		var image := Image.new()
		if image.load_png_from_buffer(Marshalls.base64_to_raw(PNG)) != OK: return false
		texture = ImageTexture.create_from_image(image)
		for index in range(KEYS.size()): regions[KEYS[index]] = Rect2(index % 8 * 128, index / 8 * 128, 128, 128)
	return true

static func paint(canvas: Node2D, key: String, center: Vector2) -> bool:
	if not prepare() or not regions.has(key): return false
	canvas.draw_texture_rect_region(texture, Rect2(center - Vector2(32,32), Vector2(64,64)), regions[key])
	return true
