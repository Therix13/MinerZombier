extends RefCounted

# Generated from the game's vector artwork by tests/build_art_atlas.gd.
# Shared 2x sprites avoid rebuilding hundreds of tiny shapes every frame.
const KEYS := ["coal:0:0","coal:0:1","coal:0:2","coal:0:3","coal:0:4","copper:0:0","copper:0:1","copper:0:2","copper:0:3","copper:0:4","copper:0:5","copper:0:6","belt:straight:0","belt:corner_right:0","belt:corner_left:0","belt:junction:0","drill:0","compactor:0","furnace:0:0","furnace:0:1","coal:1:0","coal:1:1","coal:1:2","coal:1:3","coal:1:4","copper:1:0","copper:1:1","copper:1:2","copper:1:3","copper:1:4","copper:1:5","copper:1:6","belt:straight:1","belt:corner_right:1","belt:corner_left:1","belt:junction:1","drill:1","compactor:1","furnace:1:0","furnace:1:1","coal:2:0","coal:2:1","coal:2:2","coal:2:3","coal:2:4","copper:2:0","copper:2:1","copper:2:2","copper:2:3","copper:2:4","copper:2:5","copper:2:6","belt:straight:2","belt:corner_right:2","belt:corner_left:2","belt:junction:2","drill:2","compactor:2","furnace:2:0","furnace:2:1","coal:3:0","coal:3:1","coal:3:2","coal:3:3","coal:3:4","copper:3:0","copper:3:1","copper:3:2","copper:3:3","copper:3:4","copper:3:5","copper:3:6","belt:straight:3","belt:corner_right:3","belt:corner_left:3","belt:junction:3","drill:3","compactor:3","furnace:3:0","furnace:3:1","ore:coal","ore:copper","ore:coal_2","ore:copper_2","ore:coal_3","ore:copper_3","ore:coal_4","ore:copper_4","ore:copper_ingot","ore:copper_ingot_2","ore:copper_ingot_3","ore:copper_ingot_4","ore:iron","ore:iron_2","ore:iron_3","ore:iron_4","ore:iron_ingot","ore:iron_ingot_2","ore:iron_ingot_3","ore:iron_ingot_4","ore:gold","ore:gold_2","ore:gold_3","ore:gold_4","ore:gold_ingot","ore:gold_ingot_2","ore:gold_ingot_3","ore:gold_ingot_4","platform"]
const PNG := ""
static var texture: ImageTexture
static var regions: Dictionary = {}

static func prepare() -> bool:
	if texture == null:
		var image := Image.new()
		if image.load_png_from_buffer(Marshalls.base64_to_raw(PNG)) != OK: return false
		texture = ImageTexture.create_from_image(image)
		for index in range(KEYS.size()): regions[KEYS[index]] = Rect2(index % 8 * 128, index / 8 * 128, 128, 128)
	return true

static func paint(canvas: Node2D, key: String, center: Vector2) -> bool:
	if not prepare() or not regions.has(key): return false
	canvas.draw_texture_rect_region(texture, Rect2(center - Vector2(32,32), Vector2(64,64)), regions[key])
	return true
